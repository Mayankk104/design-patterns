{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Current File with bun",
            "command": "bun ${relativeFile}",
            "problemMatcher": "$tsc",
        }
    ],
    "type": "shell",
    "presentation": {
        "reveal": "always",
        "showReuseMessage": false,
        "echo": false,
        "focus": true
    },
    "options": {
        "cwd": "${workspaceFolder}"
    }
}
